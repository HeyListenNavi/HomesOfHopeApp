{
  "expo": {
    "name": "Hope App",
    "slug": "homes-of-hope-app",
    "scheme": "hopeapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./src/assets/images/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ywam.homesofhope",
      "config": {}
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptative-icon.png",
        "backgroundColor": "#ffffff",
        "monochromeImage": "./src/assets/images/monochrome-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.ywam.homesofhope",
      "config": {
        "googleMaps": {}
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.DOWNLOAD_WITHOUT_NOTIFICATION",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {},
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-audio",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/inter/900Black/Inter_900Black.ttf"
          ]
        }
      ],
      "expo-secure-store",
      "expo-video",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash.png",
          "backgroundColor": "#ffffff",
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar",
      "expo-asset",
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "97282c8c-b55e-44cd-9e56-379809db8bb1"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/97282c8c-b55e-44cd-9e56-379809db8bb1"
    }
  }
}
